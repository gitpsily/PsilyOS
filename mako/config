# ┌──────────────────────────────────────────┐
# │  Mako Notification Config      │
# │  Colors injected by wallust template     │
# └──────────────────────────────────────────┘

max-visible=3
sort=-time
layer=overlay
anchor=top-right
default-timeout=5000

# ── Appearance ───────────────────────────────
font=JetBrainsMono Nerd Font 11
width=320
height=120
margin=8
padding=12
border-size=2
border-radius=8

# ── Colors (wallust overwrites these) ────────
background-color=#24283bdd
text-color=#c0caf5
border-color=#7aa2f7

[urgency=low]
border-color=#565f89

[urgency=high]
border-color=#f7768e
default-timeout=0
