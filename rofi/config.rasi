/* ┌──────────────────────────────────────────┐ */
/* │  Rofi Configuration            │ */
/* │  Theme sourced separately for wallust    │ */
/* └──────────────────────────────────────────┘ */

configuration {
    show-icons:     true;
    icon-theme:     "Papirus-Dark";
    display-drun:   " Apps";
    display-run:    " Run";
    display-window: " Windows";
    drun-display-format: "{name}";
    font:           "JetBrainsMono Nerd Font 12";
}

@theme "~/.config/rofi/theme.rasi"
