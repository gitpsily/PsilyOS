# ┌──────────────────────────────────────────┐
# │  PsilyOS Environment Configuration      │
# │  Copy to .env and fill in your values.  │
# │  This file is gitignored — never commit │
# │  the real .env.                         │
# └──────────────────────────────────────────┘
#
# The install script sources this early and uses it for:
#   - Git identity
#   - NAS/SMB mount credentials
#   - Claude Code MCP API keys
#   - Backup paths
#   - Generating .zshrc.local (runtime env vars)
#
# Leave blank to skip — the installer handles missing values gracefully.

# ── Identity ────────────────────────────────────
# Used by install.sh for git config --global
GIT_USER_NAME=
GIT_USER_EMAIL=

# SSH key comment (used when generating ~/.ssh/id_ed25519)
# Typically your email or username
SSH_KEY_COMMENT=

# ── NAS / SMB Mount ────────────────────────────
# Creates ~/.smbcredentials + fstab entry at /mnt/$SMB_SHARE
SMB_IP=
SMB_SHARE=
SMB_USER=
SMB_PASS=

# ── Claude Code — MCP API Keys ─────────────────
# These get exported in .zshrc.local for runtime use.
# tool-executor MCP servers read them from the environment.

# Google Gemini (deep research, brainstorming, image gen, video gen, summarization)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Apify (web scraping, RAG browser, data extraction)
# Get token: https://console.apify.com/account/integrations
APIFY_TOKEN=

# ── Claude Code — Backup ───────────────────────
# Where `claude-backup` saves tarballs (default: $HOME)
# Example: /mnt/storage/backups
CLAUDE_BACKUP_DIR=

# ── Future / Reserved ──────────────────────────
# Add new env vars here as needed. The install script
# and .zshrc.local generator will pick them up.
#
# OPENAI_API_KEY=          # If adding OpenAI MCP tools
# ELEVENLABS_API_KEY=      # If adding TTS
# DISCORD_WEBHOOK=         # If adding notifications
# HA_URL=                  # Home Assistant URL
# HA_TOKEN=                # Home Assistant long-lived access token
